# Master data service configuration.

ENVIRONMENT=development

HTTP_PORT=5002
GRPC_PORT=6002

# --- MongoDB ----------------------------------------------------------------
# This must be a NEW, EMPTY database holding master data only.
#
# The service refuses to start if the target looks like the legacy monolith
# database: the cluster0-ndqn7 Atlas cluster, or a database named prod, test or
# local. It also prefixes every collection it owns with `md_`, so it cannot
# write over a legacy collection even in a shared database.
# See internal/config/guard.go.
# 27018, not 27017. This is the host-side port the compose stack publishes
# MongoDB on; a MongoDB installed on your machine binds 127.0.0.1:27017 and
# Docker does not displace it, so 27017 from the host would silently reach
# the wrong instance. Inside compose the services use mongodb:27017.
MONGO_URI=mongodb://localhost:27018
MONGO_DATABASE=karlo_masterdata
MONGO_TIMEOUT=10s

# Global catalogues are read constantly and written rarely, so listings are
# cached in process for this long.
CATALOG_CACHE_TTL=5m

# --- Token verification -----------------------------------------------------
# This service verifies tokens but never mints them, so it needs only the
# public key from the authentication service.
JWT_PUBLIC_KEY_FILE=../authentication-service/.keys/jwt-public.pem

# --- Service-to-service -----------------------------------------------------
SERVICE_TOKEN=                    # REQUIRED
ACCEPTED_SERVICE_TOKENS=          # REQUIRED, comma-separated

AUTH_GRPC_ADDR=localhost:6001

# --- HTTP -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ----------------------------------------------------------------
# Logs are always written to stdout as JSON. Setting FLUENTD_HOST adds a second
# sink; leaving it unset is correct for local development and for platforms that
# collect stdout themselves.
#
# An unreachable collector degrades to stdout-only with a warning. It never
# stops the service from starting, and never blocks a request: shipping is
# asynchronous and bounded by FLUENTD_BUFFER_LIMIT.
LOG_LEVEL=info
# FLUENTD_HOST=localhost
FLUENTD_PORT=24224
FLUENTD_TAG_PREFIX=karlo
FLUENTD_ASYNC=true
FLUENTD_BUFFER_LIMIT=8388608
FLUENTD_TIMEOUT=3s

# --- Cache (Redis / ElastiCache) --------------------------------------------
# Optional. With REDIS_ADDR unset the service runs correctly against its
# database every time; nothing fails, it is simply slower.
#
# A cache failure is never a request failure: reads return a miss, writes are
# logged and dropped. The two primitives that cannot be faked — the login rate
# limiter and the idempotency claim — fall back to the database instead.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Short by design: a cache that takes longer than this to answer is slower than
# the query it fronts, so waiting on it makes the request worse.
REDIS_TIMEOUT=200ms
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
# Required by ElastiCache when encryption in transit is enabled, which it should
# be in production.
REDIS_TLS=false
